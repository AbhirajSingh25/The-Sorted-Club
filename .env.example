# ==============================================================================
# The Sorted Club — Global / Docker Production Environment Template
# Copy this file to '.env' before running docker compose or deploying.
# NEVER commit your production '.env' file or real credentials to version control.
# ==============================================================================

# Application Environment ('development', 'production', or 'test')
# In 'production' mode, PostgreSQL is strictly enforced and placeholder secrets are rejected.
APP_ENV=production

# PostgreSQL Database Configuration
POSTGRES_DB=sorted_club
POSTGRES_USER=sorted_user
# Generate via: openssl rand -base64 24
POSTGRES_PASSWORD=generate_a_strong_random_db_password_here_min_24_chars
DATABASE_URL=postgresql+psycopg://sorted_user:generate_a_strong_random_db_password_here_min_24_chars@postgres:5432/sorted_club

# Admin Authentication
# CRITICAL: ADMIN_SECRET_KEY / JWT_SECRET must be at least 32 characters in production.
ADMIN_USERNAME=admin
# Generate via: openssl rand -base64 18
ADMIN_PASSWORD=generate_a_secure_admin_password_here
# Generate via: openssl rand -hex 32
ADMIN_SECRET_KEY=generate_a_random_64_character_hex_secret_key_for_jwt_signing

# Host & Networking
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://thesortedclub.com
CORS_ORIGINS=https://thesortedclub.com,https://www.thesortedclub.com

# Gmail SMTP Business Notifications
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=thesortedclub@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password_here
SMTP_FROM_EMAIL=thesortedclub@gmail.com
BUSINESS_NOTIFICATION_EMAIL=thesortedclub@gmail.com

# Official Banking & UPI Payment Instructions (Displayed on Client Invoices)
PAYMENT_UPI_ID=thesortedclub@upi
PAYMENT_BANK_ACCOUNT_NAME=The Sorted Club Private Limited
PAYMENT_BANK_NAME=HDFC Bank
PAYMENT_BANK_ACCOUNT_NUMBER=50200012345678
PAYMENT_BANK_IFSC=HDFC0001234
PAYMENT_BANK_BRANCH=Indiranagar, Bangalore

# Frontend Build (Optional: defaults to relative /api when served behind Nginx)
VITE_API_URL=https://the-sorted-club.onrender.com
