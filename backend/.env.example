# ==============================================================================
# The Sorted Club — Backend Environment Configuration Template
# Copy this file to '.env' in the backend directory for local development.
# NEVER commit your production '.env' file or real credentials to version control.
# ==============================================================================

# Application Environment Mode: 'development', 'production', or 'test'
# - 'development': SQLite local database, email dispatch enabled if credentials set.
# - 'production': PostgreSQL database strictly required, strong secrets required.
# - 'test': In-memory SQLite, network/SMTP completely isolated.
APP_ENV=development

# Database Configuration
# Local development: sqlite:///./sorted_club.db
# Production: postgresql+psycopg://sorted_user:password@localhost:5432/sorted_club
DATABASE_URL=sqlite:///./sorted_club.db

# Admin Authentication Credentials
# CRITICAL: ADMIN_SECRET_KEY / JWT_SECRET must be >= 32 characters in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
ADMIN_SECRET_KEY=change_this_to_a_random_64_character_hex_secret_key

# Server Network Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://thesortedclub.com

# Official Banking & UPI Payment Instructions (Displayed on Public Invoices)
PAYMENT_UPI_ID=thesortedclub@upi
PAYMENT_BANK_ACCOUNT_NAME=The Sorted Club Private Limited
PAYMENT_BANK_NAME=HDFC Bank
PAYMENT_BANK_ACCOUNT_NUMBER=50200012345678
PAYMENT_BANK_IFSC=HDFC0001234
PAYMENT_BANK_BRANCH=Indiranagar, Bangalore

# Business Email & Operational Notifications (Gmail SMTP)
# For Gmail SMTP:
# 1. Enable 2-Step Verification on the business Google Account (thesortedclub@gmail.com).
# 2. Visit https://myaccount.google.com/apppasswords and create an App Password.
# 3. Paste the 16-character code into SMTP_PASSWORD (without spaces).
# 4. Set EMAIL_NOTIFICATIONS_ENABLED=true.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=thesortedclub@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_EMAIL=thesortedclub@gmail.com
BUSINESS_NOTIFICATION_EMAIL=thesortedclub@gmail.com

# Web Push (VAPID) Notifications for iPhone & Browser PWA
# Generate a VAPID keypair using: `npx web-push generate-vapid-keys` or `vapid --gen`
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIM_EMAIL=mailto:thesortedclub@gmail.com
